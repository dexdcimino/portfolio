#!/bin/sh
# One commit, one project — and one commit, one story.
#
# Two checks, and they catch opposite halves of the same accident:
#
#   check_scope.py  refuses a commit that reaches across unrelated PROJECTS.
#   check_sweep.py  refuses a commit that carries work inside a shared file
#                   that its message does not describe, and one that points at
#                   derived files it does not contain.
#
# See each script for what that means and why it is a hook rather than a line
# in CLAUDE.md. Both exist because a convention failed more than once.
#
# Lives here (versioned, reviewable) rather than only in .git/hooks, which git
# does not track. Install with:
#
#     python tools/bake_images.py --install-hooks
#
# commit-msg rather than pre-commit, and that is forced: both checks need the
# message — for the Spans: and Carries: escape hatches — and the message does
# not exist yet when pre-commit runs.
#
# POSIX sh on purpose: this has to run under Git Bash on Windows.

set -e

PY=python
command -v python >/dev/null 2>&1 || PY=python3

"$PY" tools/check_scope.py "$1"
exec "$PY" tools/check_sweep.py "$1"
