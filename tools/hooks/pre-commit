#!/bin/sh
# Keep the image pipeline's generated output in step with the commit: bake
# derivatives for any raster in it, rewrite the <picture> markup that points at
# them, and stage both alongside.
#
# Lives here (versioned, reviewable) rather than in .git/hooks, which git does
# not track. Install with:
#
#     python tools/bake_images.py --install-hooks
#
# POSIX sh on purpose: this has to run under Git Bash on Windows.

set -e

# Staged paths only — added/copied/modified/renamed, ignoring deletions.
staged=$(git diff --cached --name-only --diff-filter=ACMR)

# Discovery is repo-wide now, so the trigger cannot be scoped to assets/: any
# raster anywhere counts, except the folders the baker itself skips. The markup
# generator also has to run when the page or the slot table changes, since both
# decide what the generated blocks say. No match means this hook is a no-op and
# must stay completely silent (a CSS-only commit should not notice it exists).
rasters=$(printf '%s\n' "$staged" \
          | grep -Eiv '(^|/)(derived|_resources|node_modules|\.vercel)/' \
          | grep -Ei '\.(png|jpe?g)$' || true)
markup=$(printf '%s\n' "$staged" \
         | grep -E '^(index\.html|tools/image_slots\.py|tools/bake_markup\.py)$' || true)

# The accent palette is byte-duplicated into five files; check_accents.py is what
# holds them together. Trigger on any of them, plus the checker itself, so the
# commit that breaks the invariant is the one that gets told — not some later
# session wondering why one game's swatches are a different blue.
palette=$(printf '%s\n' "$staged" \
          | grep -E '^(script\.js|tools/check_accents\.py|games/(arena1|chomp)/js/pausemenu\.js|games/stickland/(src/pausemenu\.js|index\.html|v1/index\.html))$' || true)

# The cursor set (arrow / hand / I-beam paths) is duplicated into three files
# the same way the palette is; check_cursors.py holds them together. Same
# trigger logic: any copy, the source, or the checker itself.
cursors=$(printf '%s\n' "$staged" \
          | grep -E '^(script\.js|tools/check_cursors\.py|games/_shared/cursor\.js|games/stickland/(src/cursor\.js|index\.html|v1/index\.html))$' || true)

# renderMarkdown() turns prompt .md files into HTML through innerHTML, and on
# 2026-08-19 it shipped an XSS: it escaped < > and & but not quotes, so a link
# target closed its own attribute and whatever followed became an event handler.
# The fix was one .replace(), which is exactly the kind that comes back.
# check_markdown.mjs re-proves it against 24 hostile payloads in a real HTML
# parser, and separately refuses any NEW attribute the renderer interpolates
# into. Triggered on the file the function lives in, plus the checker itself.
markdown=$(printf '%s\n' "$staged" \
           | grep -E '^(script\.js|tools/check_markdown\.mjs)$' || true)

if [ -z "$rasters" ] && [ -z "$markup" ] && [ -z "$palette" ] && [ -z "$cursors" ] \
   && [ -z "$markdown" ]; then
    exit 0
fi

PY=python
command -v python >/dev/null 2>&1 || PY=python3

# First, because it is the cheapest and the only one that can fail on a commit
# touching no images at all. Nothing to regenerate here: two of the five copies
# are build output, so the fix is to re-run Stickland's build, not to patch it.
if [ -n "$palette" ]; then
    if ! out=$($PY tools/check_accents.py 2>&1); then
        printf 'pre-commit: accent palette OUT OF STEP, commit blocked\n' >&2
        printf '%s\n' "$out" >&2
        exit 1
    fi
    printf 'pre-commit: %s\n' "$out"
fi

if [ -n "$cursors" ]; then
    if ! out=$($PY tools/check_cursors.py 2>&1); then
        printf 'pre-commit: cursor set OUT OF STEP, commit blocked\n' >&2
        printf '%s\n' "$out" >&2
        exit 1
    fi
    printf 'pre-commit: %s\n' "$out"
fi

# The static half needs nothing installed; the browser half needs Chrome or Edge
# and says so rather than failing when there is none. node is already a dev
# dependency here, so a machine that can run the dev harnesses can run this.
if [ -n "$markdown" ]; then
    if command -v node >/dev/null 2>&1; then
        if ! out=$(node tools/check_markdown.mjs 2>&1); then
            printf 'pre-commit: renderMarkdown can emit markup it should not, commit blocked\n' >&2
            printf '%s\n' "$out" >&2
            exit 1
        fi
        printf '%s\n' "$out" | sed 's/^check_markdown: /pre-commit: markdown /'
    else
        printf 'pre-commit: node not found, markdown XSS check skipped\n' >&2
    fi
fi

if [ -n "$rasters" ]; then
    if ! out=$($PY tools/bake_images.py 2>&1); then
        printf 'pre-commit: image bake FAILED, commit blocked\n' >&2
        printf '%s\n' "$out" >&2
        exit 1
    fi
    # Stage the derivatives of the masters in THIS commit, not assets/derived/
    # whole. The bake is repo-wide, so staging the folder also swept in whatever
    # another session had left unbaked in the working tree — twice on 2026-08-20,
    # master not included, which is the b6ba02f shape. check_scope and check_sweep
    # both read the index, so neither can see what the bake adds after they run;
    # the fix has to be here, at the point of staging. Masters go in on stdin so a
    # path with a space in it survives.
    mine=$(printf '%s\n' "$rasters" | $PY tools/bake_images.py --derived-for)
    staged=0
    if [ -n "$mine" ]; then
        printf '%s\n' "$mine" | tr '\n' '\0' | xargs -0 git add --
        staged=$(printf '%s\n' "$mine" | grep -c . || true)
    fi
    # Pull the count straight out of the bake summary rather than recounting.
    written=$(printf '%s\n' "$out" | sed -n 's/.*[[:space:]]\([0-9][0-9]*\) written.*/\1/p' | tail -1)
    [ -n "$written" ] || written=0
    printf 'pre-commit: baked images — %s derivative(s) written, %s staged for this commit\n' "$written" "$staged"

    # Anything still untracked or unstaged under assets/derived/ after that came
    # from a master this commit does not carry. Leaving it out is the point; not
    # saying so is how it went unnoticed twice.
    left=$( { git ls-files --others --exclude-standard -- assets/derived/;
              git diff --name-only -- assets/derived/; } | sort -u | grep -c . || true)
    if [ "$left" -gt 0 ]; then
        printf 'pre-commit: %s derivative(s) under assets/derived/ belong to masters not in this commit, left alone\n' "$left"
    fi
fi

# Markup is generated from the masters, so it has to be rewritten whenever
# either side moved — and ONLY then. This block used to run whenever ANY
# trigger fired, and on 2026-08-20 a palette check on script.js tripped it
# while another session's re-exported masters sat unbaked in the tree: the
# regen restamped THEIR blocks against the new masters and staged index.html
# whole into a commit that carried none of their derivatives — new ?v= over
# old bytes under immutable caching, the Shale Spire failure, live. Same
# shape as the derived/ sweep fixed earlier the same day: a step that runs
# on any trigger instead of its own. Note this still stages index.html
# whole — if you deliberately staged only part of it, commit the image
# change separately.
if [ -n "$markup" ] || [ -n "$rasters" ]; then
    if ! out=$($PY tools/bake_markup.py 2>&1); then
        printf 'pre-commit: markup bake FAILED, commit blocked\n' >&2
        printf '%s\n' "$out" >&2
        exit 1
    fi
    if ! printf '%s\n' "$out" | grep -q 'already current'; then
        git add index.html
        printf 'pre-commit: %s\n' "$out"
    fi

    # Belt and braces: the bakes above make this pass by construction, so a
    # failure here means something the generators cannot fix by themselves —
    # a master that does not exist, or a slot name nothing defines.
    if ! out=$($PY tools/bake_markup.py --check 2>&1); then
        printf 'pre-commit: image markup check FAILED, commit blocked\n' >&2
        printf '%s\n' "$out" >&2
        exit 1
    fi
fi
