_resources/
*.psd
*.ai
*.tmp
.DS_Store
Thumbs.db
desktop.ini
__pycache__/
*.pyc

# stray output from local headless-browser testing
*.log

# build.mjs writes the single-file game here; the shipped copy is the version
# folder beside it (games/<name>/v1/). Tracking this one would commit a 1MB
# duplicate on every build and serve the game at a second URL.
# Stickland's index.html is generated by its build.mjs; Chomp's (and any
# future game's) is source. Scope the ignore to the one generated file.
games/stickland/index.html
node_modules/

# games/surveyor/dev/shots.mjs output, carried over from that game's own repo
# when it was imported. The per-world frames are regenerable in one command and
# half a megabyte each, and sheet*.html is the scaffolding they are photographed
# through; only the contact sheets it produces are kept.
games/surveyor/dev/shots/*.png
games/surveyor/dev/shots/sheet*.html

# Editor state, not project. A colour theme is a property of whoever is
# sitting here, and committing it means the next person's editor silently
# changes when they clone.
.vscode/

# dev/gallery.mjs candidates, for every game. Same reasoning as the surveyor
# block above and the same split: several deliberately-varied frames per named
# shot, a megabyte each, regenerable with one command — and the point of them
# is that a person looks at the CONTACT SHEET once and picks. The sheet is
# kept (sheet.jpg); the candidates and the html it is photographed through are
# not. fourup-boxes.json IS kept: it is where the figure stood in each panel,
# and tools/make_gallery_composite.py cannot rebuild the four-up without it.
games/*/dev/shots/gallery/*.png
games/*/dev/shots/gallery/sheet.html
games/*/dev/shots/gallery/sheet.css
